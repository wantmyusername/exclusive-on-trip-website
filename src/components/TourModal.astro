---
import Icon from "./Icon.astro";
import { SITE } from "../data/content.js";

const { items } = Astro.props;
const data = items.map((i) => ({
  id: i.id,
  title: i.title,
  desc: i.desc,
  image: i.image,
  price: i.price,
  rating: i.rating,
  reviews: i.reviews,
  duration: i.duration,
  details: i.details,
  link: i.link,
}));
---

<script type="application/json" id="tours-json" set:html={JSON.stringify(data)}></script>

<div
  id="tour-modal"
  class="fixed inset-0 z-[200] items-center justify-center p-0 md:p-4 lg:p-10"
  role="dialog"
  aria-modal="true"
>
  <div id="modal-backdrop" class="absolute inset-0 bg-slate-900/90 backdrop-blur-md cursor-pointer"></div>
  <div
    class="modal-inner relative bg-white w-full max-w-6xl h-full md:h-auto md:max-h-[90vh] md:rounded-[2rem] shadow-2xl overflow-hidden flex flex-col md:flex-row z-10"
  >
    <button
      id="modal-close"
      class="absolute top-4 right-4 z-50 p-2 bg-black/20 hover:bg-white text-white hover:text-slate-900 rounded-full transition-all backdrop-blur-md"
      aria-label="Cerrar"
    >
      <Icon name="x" class="w-6 h-6" />
    </button>

    <div class="modal-img-wrap w-full md:w-[45%] h-64 md:h-auto relative shrink-0 overflow-hidden">
      <img id="modal-img" src="" alt="" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-transparent to-transparent opacity-80">
      </div>
      <div class="absolute bottom-8 left-8 right-8">
        <span
          class="poppins inline-flex items-center gap-2 bg-brand text-slate-900 text-[10px] font-bold px-3 py-1 rounded-full uppercase mb-4 shadow-xl"
        >
          <Icon name="zap" class="w-3 h-3" /> Recomendado por {SITE.name}
        </span>
        <h2
          id="modal-title"
          class="poppins text-3xl md:text-4xl font-bold text-white leading-tight drop-shadow-2xl"
        >
        </h2>
      </div>
    </div>

    <div class="flex-1 flex flex-col bg-white overflow-hidden">
      <div class="p-6 md:p-10 overflow-y-auto flex-1">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-10">
          <div class="bg-amber-50 p-4 rounded-2xl border border-amber-100">
            <p class="poppins text-[10px] font-bold text-amber-600 uppercase mb-2 tracking-widest">Rating</p>
            <div class="flex items-center gap-2">
              <Icon name="star" class="w-5 h-5 text-amber-500" fill="currentColor" />
              <span id="modal-rating" class="text-xl font-bold text-slate-800"></span>
            </div>
            <p id="modal-reviews" class="text-[10px] text-amber-500 font-medium"></p>
          </div>
          <div class="bg-blue-50 p-4 rounded-2xl border border-blue-100">
            <p class="poppins text-[10px] font-bold text-blue-600 uppercase mb-2 tracking-widest">Duración</p>
            <div class="flex items-center gap-2">
              <Icon name="clock" class="w-5 h-5 text-blue-500" />
              <span id="modal-duration" class="text-xl font-bold text-slate-800"></span>
            </div>
            <p class="text-[10px] text-blue-400 font-medium">Tiempo estimado</p>
          </div>
          <div class="bg-purple-50 p-4 rounded-2xl border border-purple-100">
            <p class="poppins text-[10px] font-bold text-purple-600 uppercase mb-2 tracking-widest">Acceso</p>
            <div class="flex items-center gap-2">
              <Icon name="ticket" class="w-5 h-5 text-purple-500" />
              <span class="text-xl font-bold text-slate-800">Digital</span>
            </div>
            <p class="text-[10px] text-purple-400 font-medium">Confirmación instantánea</p>
          </div>
          <div class="bg-emerald-50 p-4 rounded-2xl border border-emerald-100">
            <p class="poppins text-[10px] font-bold text-emerald-600 uppercase mb-2 tracking-widest">Seguridad</p>
            <div class="flex items-center gap-2">
              <Icon name="shield-check" class="w-5 h-5 text-emerald-500" />
              <span class="text-xl font-bold text-slate-800">Oficial</span>
            </div>
            <p class="text-[10px] text-emerald-400 font-medium">Operador verificado</p>
          </div>
        </div>

        <div class="mb-10">
          <h3 class="poppins text-slate-900 font-bold text-lg mb-4 flex items-center gap-2 italic">
            <Icon name="info" class="w-5 h-5 text-brand" /> Acerca del tour
          </h3>
          <p
            id="modal-desc"
            class="text-slate-600 leading-relaxed text-sm md:text-base border-l-4 border-brand/30 pl-6 whitespace-pre-line"
          >
          </p>
        </div>

        <div class="mb-6">
          <h3 class="poppins text-slate-900 font-bold text-xs uppercase tracking-[0.2em] mb-6">
            Incluye tu experiencia
          </h3>
          <div id="modal-highlights" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></div>
        </div>
      </div>

      <div
        class="p-6 md:px-10 md:py-8 bg-slate-900 flex flex-col sm:flex-row items-center justify-between gap-6"
      >
        <div class="text-center sm:text-left">
          <p class="poppins text-slate-400 text-[10px] font-bold uppercase tracking-widest mb-1">
            Precio garantizado
          </p>
          <span id="modal-price" class="poppins text-4xl font-bold text-white tracking-tighter"></span>
        </div>
        <a
          id="modal-link"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="poppins w-full sm:w-auto bg-brand hover:brightness-110 text-slate-900 px-10 py-5 rounded-2xl font-bold transition-all shadow-xl flex items-center justify-center gap-3 group text-sm"
        >
          RESERVAR AHORA
          <Icon
            name="external-link"
            class="w-5 h-5 group-hover:rotate-12 transition-transform"
          />
        </a>
      </div>
    </div>
  </div>
</div>
