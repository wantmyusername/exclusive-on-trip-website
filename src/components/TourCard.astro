---
import Icon from "./Icon.astro";

const { item, delay = 0 } = Astro.props;
const rating = (item.rating ?? 5).toFixed(1);
---

<article
  class="tour-card card-enter group relative aspect-[4/5] rounded-[2rem] overflow-hidden shadow-2xl cursor-pointer bg-slate-900 isolate"
  data-tour-id={item.id}
  data-category={item.category}
  style={`animation-delay:${delay}ms`}
  tabindex="0"
  role="button"
  aria-label={`Ver detalles: ${item.title}`}
>
  <img
    src={item.image}
    alt={item.title}
    loading="lazy"
    class="absolute inset-0 w-full h-full object-cover opacity-80"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/20 to-transparent pointer-events-none">
  </div>

  <div
    class="absolute top-5 left-5 z-10 bg-black/20 backdrop-blur-md border border-white/10 px-3 py-1.5 rounded-full flex items-center gap-1.5"
  >
    <Icon name="star" class="w-3 h-3 text-brand" fill="currentColor" />
    <span class="text-white text-[11px] font-bold">{rating}</span>
  </div>

  <div class="absolute bottom-0 left-0 right-0 p-6 z-10">
    <p class="poppins text-brand text-[10px] font-bold uppercase tracking-[0.2em] opacity-90 mb-2">
      Cancún Exclusive
    </p>
    <h3
      class="card-title poppins text-white text-xl font-bold mb-4 leading-tight transition-colors line-clamp-2"
    >
      {item.title}
    </h3>
    <div class="flex items-center justify-between">
      <div class="bg-white/5 backdrop-blur-xl border border-white/10 px-4 py-2 rounded-2xl">
        <p class="poppins text-white/40 text-[9px] font-bold uppercase tracking-widest mb-1">Desde</p>
        <span class="poppins text-brand font-bold text-lg">{item.price}</span>
      </div>
      <div class="plus-btn bg-white/10 text-white p-3 rounded-full backdrop-blur-md border border-white/10 shadow-lg">
        <Icon name="plus" class="w-5 h-5" />
      </div>
    </div>
  </div>
</article>
